# Copy to .env and fill in. Never commit .env.

# gemini | ollama
LLM_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for current free-tier model names
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded, rate limited or slow
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Optional local fallback (https://ollama.com)
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
